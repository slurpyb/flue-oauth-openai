{
  "name": "@slurpyb/flue-oauth-openai",
  "version": "0.1.0",
  "homepage": "https://github.com/slurpyb/flue-oauth-openai#readme",
  "bugs": {
    "url": "https://github.com/slurpyb/flue-oauth-openai/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slurpyb/flue-oauth-openai.git"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunup",
    "format": "oxfmt",
    "lint": "eslint",
    "dev": "bunup --watch",
    "type-check": "bun check",
    "release": "bunx bumpp --commit --push --tag",
    "prepare": "bun simple-git-hooks",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@flue/cli": "^2.3.0",
    "@flue/runtime": "^2.3.0",
    "@fullsnacklab/oxfmt-config": "^2.0.3",
    "@types/bun": "^1.4.0",
    "@types/proper-lockfile": "^4.1.4",
    "bunup": "^0.16.32",
    "eslint": "^10.14.0",
    "eslint-plugin-typefest": "^1.5.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-typescript": "^1.1.0",
    "oxfmt": "^0.78.0",
    "proper-lockfile": "^4.1.2",
    "simple-git-hooks": "^2.13.1",
    "ts-extras": "^2.0.0",
    "type-fest": "^5.10.0",
    "typescript": "^6"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.js",
  "types": "./dist/types.d.ts",
  "simple-git-hooks": {
    "pre-commit": "bun run lint && bun run type-check"
  },
  "dependencies": {
    "lowdb": "^7.0.1",
    "valibot": "^1.5.0",
    "write-json-file": "^7.0.0"
  }
}
