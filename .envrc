watch_file .infisical.yaml

local infisical_path="/"
local infisical_env="dev"


if ! _infisical_exports="$(infisical export --path $infisical_path --env $infisical_env --format=dotenv-eval )"; then
  unset _infisical_exports
  log_error "Infisical export failed; project credentials were not loaded"
  return 1
fi

if ! eval "$_infisical_exports"; then
  unset _infisical_exports
  log_error "Infisical environment could not be loaded"
  return 1
fi
unset _infisical_exports
